+
+void MainWindow::OnMenuInstallDuoCompanion() {
+    const QStringList paths = QFileDialog::getOpenFileNames(
+        this, tr("Install Duo Companion"),
+        QString::fromStdString(UISettings::values.roms_path),
+        tr("Duo Companion (*.dsmod.zip *.zip)"));
+    if (paths.isEmpty()) {
+        return;
+    }
+    DuoQt::InstallCompanions(this, paths);
+}
+
+void MainWindow::OnMenuRemoveDuoCompanion() {
+    DuoQt::RemoveCompanionInteractive(this);
+}
+
+void MainWindow::OnGameListDumpDuoFiles() {
+    // Wired from the game-list context menu when a title is selected.
+    // title id / name come from the current game-list selection in Claude's build;
+    // here we fall back to asking for a title id if none is selected.
+    DuoQt::DumpCompanionFiles(this, 0, {});
+}
