#!/bin/sh
# AppImage launcher for Fritchii on AYN Thor (ArmadaOS / Fedora, Adreno 740 Turnip).
# Used with linuxdeploy (--custom-apprun). Hooks live next to the binaries under usr/bin.
HERE="$(dirname "$(readlink -f "$0")")"
export APPDIR="${APPDIR:-$HERE}"
export PATH="$HERE/usr/bin:$PATH"
export QT_PLUGIN_PATH="${QT_PLUGIN_PATH:-$HERE/usr/plugins}"

# Game Mode (gamescope): Qt is most reliable through XWayland there.
if [ -n "$GAMESCOPE_WAYLAND_DISPLAY" ] && [ -z "$QT_QPA_PLATFORM" ]; then
    export QT_QPA_PLATFORM=xcb
fi

# Bigger Mesa shader cache so Switch 2 titles do not rebuild shaders every launch.
export MESA_SHADER_CACHE_MAX_SIZE="${MESA_SHADER_CACHE_MAX_SIZE:-4G}"

# Source Thor hooks (clock-max, Turnip ICD pick, Duo companion CLI).
if [ -f "$HERE/usr/bin/AppRun.lib" ]; then
    # shellcheck source=/dev/null
    . "$HERE/usr/bin/AppRun.lib"
fi
for hook in "$HERE"/usr/bin/*.hook; do
    [ -e "$hook" ] || continue
    # shellcheck source=/dev/null
    . "$hook"
done

MAIN_BIN=eden
if [ "$1" = "--cli" ]; then
    shift
    if [ -x "$HERE/usr/bin/eden-cli" ]; then
        exec "$HERE/usr/bin/eden-cli" "$@"
    fi
    # fritchii-v6.5 ships GUI-only on Linux; fall through to the Qt binary.
fi
if [ -x "$HERE/usr/bin/${0##*/}" ] && [ "${0##*/}" != "AppRun" ]; then
    exec "$HERE/usr/bin/${0##*/}" "$@"
fi
exec "$HERE/usr/bin/$MAIN_BIN" "$@"
